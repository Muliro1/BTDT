extends ../layouts/layout

block content
  .trip-detail
    .detail-header
      .detail-actions-top
        a.btn-secondary(href="/trips")
          i.fas.fa-arrow-left
          | Back to Trips
        .detail-actions
          a.btn-edit(href=`/trips/${trip._id}/edit`)
            i.fas.fa-edit
            | Edit
          form.delete-form(
            action=`/trips/${trip._id}?_method=DELETE`
            method="POST"
            style="display: inline;"
          )
            button.btn-delete(
              type="submit"
              onclick="return confirm('Are you sure you want to delete this trip?')"
            )
              i.fas.fa-trash
              | Delete
    
    .detail-content
      .detail-gallery
        if trip.photos && trip.photos.length > 0
          .main-photo
            img(src=trip.photos[0] alt=trip.destination)
          if trip.photos.length > 1
            .photo-thumbnails
              each photo in trip.photos.slice(1, 5)
                img(src=photo alt=trip.destination)
        else
          .no-photos
            i.fas.fa-camera
            p No photos available
      
      .detail-info
        h1= trip.destination
        .detail-meta
          .meta-item
            i.fas.fa-map-pin
            span= trip.country
          .meta-item
            i.far.fa-calendar-alt
            span= trip.formattedStartDate || trip.startDate.toLocaleDateString()
            |  - 
            span= trip.formattedEndDate || trip.endDate.toLocaleDateString()
          if trip.duration > 0
            .meta-item
              i.far.fa-clock
              span #{trip.duration} day#{trip.duration > 1 ? 's' : ''}
          .meta-item
            i.fas.fa-star
            .rating-display
              - for(let i = 1; i <= 5; i++)
                if i <= trip.rating
                  i.fas.fa-star
                else
                  i.far.fa-star
          if trip.budget > 0
            .meta-item
              i.fas.fa-money-bill-wave
              span $#{trip.budget.toLocaleString()}
      
      if trip.highlights && trip.highlights.length > 0
        .detail-section
          h2
            i.fas.fa-list-ul
            | Highlights
          ul.highlights-list
            each highlight in trip.highlights
              li
                i.fas.fa-check-circle
                = highlight
      
      if trip.notes
        .detail-section
          h2
            i.fas.fa-sticky-note
            | Notes
          .notes-content= trip.notes
      
      .detail-timestamps
        small Created: #{new Date(trip.createdAt).toLocaleString()}
        if trip.updatedAt && trip.updatedAt.getTime() !== trip.createdAt.getTime()
          small Updated: #{new Date(trip.updatedAt).toLocaleString()}

