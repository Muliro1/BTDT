extends ../layouts/layout

block content
  .page-header
    h1
      i.fas.fa-plane-departure
      | My Travel Journeys
    if trips && trips.length > 0
      span.trip-count #{trips.length} trip#{trips.length > 1 ? 's' : ''}
  
  if trips && trips.length > 0
    .trip-grid
      each trip in trips
        .trip-card
          .trip-image
            if trip.photos && trip.photos.length > 0
              img(src=trip.photos[0] alt=trip.destination loading="lazy")
            else
              .placeholder-image
                i.fas.fa-image
          .trip-content
            .trip-header
              h2.trip-title
                a(href=`/trips/${trip._id}`)= trip.destination
              .trip-rating
                - for(let i = 1; i <= 5; i++)
                  if i <= trip.rating
                    i.fas.fa-star
                  else
                    i.far.fa-star
            .trip-meta
              .meta-item
                i.fas.fa-map-pin
                span= trip.country
              .meta-item
                i.far.fa-calendar-alt
                span= trip.formattedStartDate || trip.startDate.toLocaleDateString()
            if trip.highlights && trip.highlights.length > 0
              .trip-highlights
                each highlight in trip.highlights.slice(0, 2)
                  span.highlight-tag= highlight
                if trip.highlights.length > 2
                  span.highlight-tag.more +#{trip.highlights.length - 2} more
            .trip-actions
              a.btn-action.btn-view(href=`/trips/${trip._id}`)
                i.fas.fa-eye
                span View
              a.btn-action.btn-edit(href=`/trips/${trip._id}/edit`)
                i.fas.fa-edit
                span Edit
              form.delete-form(action=`/trips/${trip._id}?_method=DELETE` method="POST")
                button.btn-action.btn-delete(type="submit" onclick="return confirm('Are you sure you want to delete this trip?')")
                  i.fas.fa-trash
                  span Delete
  else
    .empty-state
      i.fas.fa-suitcase
      h2 No trips yet
      p Start your travel journal by adding your first adventure!
      a.btn-primary(href="/trips/create")
        i.fas.fa-plus
        | Add Your First Trip

